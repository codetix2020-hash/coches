# Copia este fichero a .env y rellena tus valores.
# NUNCA subas .env al repositorio (ya está en .gitignore).

# ── Telegram ──────────────────────────────────────────────
# Crea tu bot con @BotFather en Telegram y pega el token aquí.
# TELEGRAM_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ── Correo IMAP (para leer alertas de portales) ───────────
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=tuemail@gmail.com
# IMAP_PASS=tu-contraseña-de-aplicacion

# ── Claude API (visión de fotos, apagado por defecto) ─────
# Solo necesario si activas vision.activo = true en config.yaml.
# ANTHROPIC_API_KEY=sk-ant-...

# ── Ruta personalizada a la BD (opcional) ─────────────────
# CAZACHOLLOS_DB=C:/Users/bruno/cazachollos.db
